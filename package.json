{
  "name": "codeguard-pro",
  "productName": "CodeGuard Pro",
  "version": "1.0.0",
  "description": "Plataforma educativa personal, monousuario, local y offline-first para organizar la formación técnica, gestionar el roadmap ASCENSO, biblioteca de documentos PDF, base de conocimiento, evaluaciones, evidencias y laboratorios.",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "cross-env NODE_ENV=development electron .",
    "build:server": "node scripts/build-server.js",
    "verify:server": "node scripts/verify-server-build.js",
    "build": "npm run build:server && npm run verify:server && electron-builder --publish never",
    "build:win": "npm run build:server && npm run verify:server && electron-builder --win --publish never",
    "build:linux": "npm run build:server && npm run verify:server && electron-builder --linux --publish never",
    "postinstall": "electron-builder install-app-deps",
    "test:electron": "node --test electron/*.test.js"
  },
  "author": "CodeGuard Pro Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/MaverickBms/CodeGuard-Pro.git"
  },
  "keywords": [
    "codeguard",
    "education",
    "offline",
    "django",
    "electron",
    "learning"
  ],
  "build": {
    "appId": "com.codeguard.pro",
    "productName": "CodeGuard Pro",
    "copyright": "© 2026 CodeGuard Pro",
    "buildVersion": "1.0.0",
    "asar": true,
    "compression": "maximum",
    "files": [
      "electron/**/*",
      "static/icons/icon.png",
      "static/icons/icon.ico",
      "README.md",
      "README_WINDOWS.md"
    ],
    "extraResources": [
      {
        "from": "dist-server/CodeGuardServer",
        "to": "server",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "static/icons",
        "to": "icons",
        "filter": [
          "icon.png",
          "icon.ico"
        ]
      },
      {
        "from": "README.md",
        "to": "README.md"
      },
      {
        "from": "README_WINDOWS.md",
        "to": "README_WINDOWS.md"
      }
    ],
    "extraMetadata": {
      "main": "electron/main.js"
    },
    "directories": {
      "buildResources": "static/icons",
      "output": "dist"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "static/icons/icon.png",
      "category": "Education",
      "artifactName": "CodeGuard-Pro-${version}-${arch}.${ext}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "static/icons/icon.ico"
    }
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0"
  }
}
