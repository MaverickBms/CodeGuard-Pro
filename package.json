{
  "name": "codeguard-pro",
  "productName": "CodeGuard Pro",
  "version": "1.0.0",
  "description": "Plataforma educativa personal, monousuario, local y offline-first para organizar la formación técnica, gestionar el roadmap ASCENSO, biblioteca de documentos PDF, base de conocimiento, evaluaciones, evidencias y laboratorios.",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "cross-env NODE_ENV=development electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:linux": "electron-builder --linux",
    "postinstall": "electron-builder install-app-deps"
  },
  "author": "CodeGuard Pro Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/MaverickBms/CodeGuard-Pro.git"
  },
  "keywords": [
    "codeguard",
    "education",
    "offline",
    "django",
    "electron",
    "learning"
  ],
  "build": {
    "appId": "com.codeguard.pro",
    "productName": "CodeGuard Pro",
    "copyright": "© 2026 CodeGuard Pro",
    "buildVersion": "1.0.0",
    "asar": true,
    "compression": "maximum",
    "files": [
      "electron/**/*",
      "static/icons/icon.png",
      "static/icons/icon.ico",
      "README.md",
      "README_WINDOWS.md",
      "IEEE830.md",
      "docs/**/*"
    ],
    "extraResources": [
      {
        "from": "dist-server/CodeGuardServer",
        "to": "server",
        "filter": ["**/*"]
      },
      {
        "from": "static/icons",
        "to": "icons",
        "filter": ["icon.png", "icon.ico"]
      },
      {
        "from": "README.md",
        "to": "README.md"
      },
      {
        "from": "README_WINDOWS.md",
        "to": "README_WINDOWS.md"
      },
      {
        "from": "IEEE830.md",
        "to": "IEEE830.md"
      },
      {
        "from": "docs",
        "to": "docs",
        "filter": ["**/*"]
      }
    ],
    "extraMetadata": {
      "main": "electron/main.js"
    },
    "directories": {
      "buildResources": "static/icons",
      "output": "dist"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": ["x64"]
        }
      ],
      "icon": "static/icons/icon.png",
      "category": "Education",
      "artifactName": "CodeGuard-Pro-${version}-${arch}.${ext}"
    }
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0"
  }
}
