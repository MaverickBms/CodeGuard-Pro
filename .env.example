# CodeGuard Pro — variables de entorno (copiar a .env y ajustar)
# Nunca commitear el .env con valores reales (secreto).

DJANGO_SECRET_KEY=cambiar-esta-clave-por-una-aleatoria-de-almenos-50-caracteres
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DJANGO_SESSION_TIMEOUT_MINUTES=15
DJANGO_LOG_LEVEL=INFO
