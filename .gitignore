# CodeGuard Pro — .gitignore

# Entornos virtuales
.venv/
venv/
env/
*.pyc
__pycache__/
*.pyo

# Base de datos SQLite y clave secreta local
db.sqlite3
db.sqlite3-journal
.secret_key
data/

# Media y archivos de usuario
media/
staticfiles/

# Logs
logs/*.log
*.log

# Entorno (secreto — no commitear)
.env

# IDE / OS
.idea/
.vscode/
*.swp
*.swo
.DS_Store
.directory

# Empaquetados / backups locales
*.tar.gz
*.zip

# Node.js / Electron
node_modules/
dist/
dist-server/
build/

# Python virtual env
.env
